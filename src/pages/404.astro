---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found"
  description="That URL is not on this site."
  ogImage="/og/404.png"
  noindex={true}
>
  <div class="wrap page-intro">
    <p class="kicker">404</p>
    <div class="page-title">
      <h1>This page is not on the map.</h1>
      <p>The address does not match a page on this site. The studies and notes are linked from the home page.</p>
    </div>
    <div class="actions">
      <a class="button" href="/">Back home</a>
      <a class="button secondary" href="/work/">View the work</a>
    </div>
  </div>
</Base>
